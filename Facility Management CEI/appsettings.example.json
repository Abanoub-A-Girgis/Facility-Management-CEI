{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "IfcProcessing": {
    "UploadDirectory": "data",
    "MaxUploadBytes": 2147483648,
    "AllowedExtensions": [ ".ifc" ],
    "AllowedContentTypes": [
      "application/octet-stream",
      "application/ifc",
      "application/x-step",
      "text/plain"
    ],
    "ValidateIfcHeader": true,
    "HeaderValidationBytes": 8192
  },
  "Viewer": {
    "FlashIntervalMs": 750,
    "SeverityColors": {
      "Severe": [ 255, 0, 0, 255 ],
      "High": [ 255, 160, 16, 255 ],
      "Medium": [ 255, 224, 32, 255 ],
      "Low": [ 0, 255, 0, 255 ]
    }
  },
  "ConnectionStrings": {
    "ProjectDataBase": "Server=.;Database=ProjectDataBaseWithAPINewViewer;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}
