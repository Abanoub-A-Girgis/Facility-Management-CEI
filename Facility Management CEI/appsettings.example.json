{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "SeedAdmin": {
    "Enabled": false,
    "UserName": "",
    "Email": "",
    "FirstName": "Admin",
    "Password": ""
  },
  "IfcProcessing": {
    "UploadDirectory": "data",
    "MaxUploadBytes": 2147483648,
    "AllowedExtensions": [ ".ifc" ],
    "AllowedContentTypes": [
      "application/octet-stream",
      "application/ifc",
      "application/x-step",
      "text/plain"
    ],
    "ValidateIfcHeader": true,
    "HeaderValidationBytes": 8192
  },
  "Viewer": {
    "FlashIntervalMs": 750,
    "SeverityColors": {
      "Severe": [ 220, 38, 38, 255 ],
      "High": [ 249, 115, 22, 255 ],
      "Medium": [ 234, 179, 8, 255 ],
      "Low": [ 22, 163, 74, 255 ]
    }
  },
  "ConnectionStrings": {
    "ProjectDataBase": "Server=.;Database=ProjectDataBaseWithAPINewViewer;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}
